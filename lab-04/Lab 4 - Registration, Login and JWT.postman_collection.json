            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Login returns only jwt_token', function () { pm.expect(Object.keys(body)).to.eql(['jwt_token']); });",
                  "pm.environment.set('token', body.jwt_token);"
